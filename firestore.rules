rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /referater/{referat} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /lejligheder/{lejlighed} {
      // update only, not create/delete - the app never adds or removes apartments, this is a
      // fixed set that only gets edited in place, and that's enforced here rather than just
      // in the UI, since client-side controls can be bypassed by calling Firestore directly.
      allow read: if request.auth != null;
      allow update: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /generalforsamling/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /articles/{article} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /comments/{comment} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /profiles/{profileId} {
      // Any signed-in user may fetch a single known profile by id (own profile,
      // an article author's profile for the mailto link, etc).
      allow get: if request.auth != null;
      // Listing/querying the whole collection (e.g. the admin-only "Brugere" page)
      // requires the admin role - this is the actual security boundary, since
      // client-side route guards can be bypassed by calling Firestore directly.
      allow list: if request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null && request.auth.uid == profileId;
    }
  }
}
