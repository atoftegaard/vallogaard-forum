# Secret key for the reCAPTCHA v3 site registered at
# https://www.google.com/recaptcha/admin/create - never commit the real value.
# Copy this file to .env and fill in the real key.
RECAPTCHA_SECRET_KEY=

# Gmail account used to send notification emails (nodemailer). GMAIL_APP_PASSWORD is an
# app password from https://myaccount.google.com/apppasswords, not the account's login
# password - never commit the real values.
GMAIL_USER=
GMAIL_APP_PASSWORD=
